{
  "name": "nari-nuna-haven",
  "version": "0.2.0",
  "private": true,
  "description": "Nari Nuna's multi-page Haven website.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/validate-build.mjs && node scripts/validate-performance.mjs",
    "preview": "vite preview",
    "verify:preview": "node scripts/verify-preview.mjs",
    "start": "npm run preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run verify:preview",
    "lint": "eslint . --ignore-pattern dist",
    "artwork:prepare": "python3 scripts/prepare-responsive-artwork.py"
  },
  "dependencies": {
    "@lucide/vue": "^1.31.0",
    "motion-v": "^2.3.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "22.19.19",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "9.39.4",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.4.0",
    "sass": "^1.92.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.0.7"
  },
  "type": "module",
  "displayName": "Nari Nuna's Haven"
}
